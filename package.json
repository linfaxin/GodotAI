{
  "name": "@godot-js/editor",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.11.0+sha1.4048eeefd564ff1ab248fac3e2854d38245fe2f1",
  "scripts": {
    "playground:serve": "node scripts/test/serve-browser-playground.mjs",
    "build": "pnpm -r build",
    "test": "node scripts/test/run-runtime-matrix.mts",
    "test:skip-builds": "node scripts/test/run-runtime-matrix.mts --skip-builds",
    "test:react": "pnpm --filter @godot-js/react test && pnpm --filter @godot-js/react-build test",
    "test:browser:unit": "pnpm --filter @godot-js/web-bridge test && pnpm --filter @godot-js/react-browser test && node --test scripts/release/test/web-release.test.mjs scripts/test/browser-server.test.mjs",
    "test:browser:real": "node scripts/test/browser-playground.mjs",
    "test:browser:stress": "node scripts/test/browser-stress.mjs",
    "browser:engine": "node scripts/test/build-browser-engine.mjs",
    "browser:prepare": "node scripts/test/prepare-browser-playground.mjs",
    "browser:release:build": "node scripts/release/build-web-release.mjs",
    "browser:release:collect": "node scripts/release/collect-browser-evidence.mjs",
    "browser:release:verify": "node scripts/release/verify-web-release.mjs",
    "browser:release:publish": "node scripts/release/publish-web-release.mjs",
    "changeset": "changeset",
    "ci:should-publish": "node scripts/release/should-publish.js",
    "ci:publish": "node scripts/release/publish.js",
    "ci:test-project": "node scripts/release/test-project.js",
    "ci:version": "changeset version && node scripts/release/version.js"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "@types/node": "^24.12.2"
  }
}
