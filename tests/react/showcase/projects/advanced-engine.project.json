    "/src/App.tsx": "import * as React from 'react';\nimport {Node2D,Node3D,MeshInstance3D,Camera3D,DirectionalLight3D,Skeleton3D,BoneAttachment3D,AnimationPlayer,AnimationTree,NativeScene,useNodeRef,useProcess} from '@godot-js/react';\nimport {useResource,useDemo} from '@playground/api';\nconst checks={skeleton:false,blendTree:false,stateMachine:false,prefab:false,replacement:false,model:false,nativeRig:false};\nfunction Rig(){\n const profile=useResource('rig','SkeletonProfile'),mesh=useResource('joint','Mesh'),ref=useNodeRef<'Skeleton3D'>(),time=React.useRef(0);\n useProcess(ref,{writes:['bones']},(c,dt)=>{time.current+=dt;c.command('setBonePosePosition',1,{x:Math.sin(time.current)*.3,y:.6,z:0});c.command('setBonePoseRotation',1,{x:0,y:0,z:Math.sin(time.current*.2),w:Math.cos(time.current*.2)});const pose=c.command<{origin:{y:number}}>('getBoneGlobalPose',1);checks.skeleton=c.command('getBoneCount')===2&&pose.origin.y>.5;});\n return <Skeleton3D ref={ref} initial={{profile}} position={{x:-1.4,y:0,z:0}} engineOwned={['bones']}><BoneAttachment3D boneName=\"Tip\"><MeshInstance3D mesh={mesh} position={{x:0,y:.2,z:0}}/></BoneAttachment3D></Skeleton3D>;\n}\nfunction Blend(){\n const library=useResource('clips','AnimationLibrary'),treeRoot=useResource('blend','AnimationNodeBlendTree'),tree=useNodeRef<'AnimationTree'>(),mover=useNodeRef<'Node2D'>();\n useProcess(tree,{writes:['animationParameters','playback']},c=>{c.command('setParameterNumber','parameters/Mix/blend_amount',.5);c.command('advance',.016);checks.blendTree=Math.abs((mover.current?.readPosition().x??0)-5)<.01;});\n return <Node2D><Node2D name=\"Mover\" ref={mover} engineOwned={['transform2d']}/><AnimationPlayer name=\"Player\" library={library} callbackModeProcess={2}/><AnimationTree ref={tree} treeRoot={treeRoot} animPlayer=\"../Player\" active callbackModeProcess={2} engineOwned={['animationParameters','playback']}/></Node2D>;\n}\nfunction State(){\n const library=useResource('clips','AnimationLibrary'),treeRoot=useResource('states','AnimationNodeStateMachine'),tree=useNodeRef<'AnimationTree'>(),mover=useNodeRef<'Node2D'>(),phase=React.useRef(0);\n useProcess(tree,{writes:['playback']},c=>{if(!phase.current){c.command('startState','Idle');c.command('advance',.01);phase.current=1;return;}if(phase.current===1){c.command('travel','Move');phase.current=2;}c.command('advance',.016);checks.stateMachine=c.command('getCurrentState')==='Move'&&Math.abs((mover.current?.readPosition().x??0)-10)<.01;});\n return <Node2D><Node2D name=\"Mover\" ref={mover} engineOwned={['transform2d']}/><AnimationPlayer name=\"Player\" library={library} callbackModeProcess={2}/><AnimationTree ref={tree} treeRoot={treeRoot} animPlayer=\"../Player\" active callbackModeProcess={2} engineOwned={['playback']}/></Node2D>;\n}\nfunction Prefab(){\n const a=useResource('/assets/left.scene.json','PackedScene'),b=useResource('/assets/right.scene.json','PackedScene'),ref=useNodeRef<'Node3D'>(),frames=React.useRef(0),[second,setSecond]=React.useState(false);\n useProcess(ref,{},c=>{const p=c.command<{x:number}>('getScenePosition','Child');if(p.x===-1)checks.prefab=true;if(p.x===1&&checks.prefab)checks.replacement=true;if(++frames.current===30)setSecond(true);});\n return <NativeScene ref={ref} scene={second?b:a} position={{x:0,y:-.5,z:0}}/>;\n}\nfunction NativeRig(){const scene=useResource('/assets/rig.scene.json','PackedScene'),ref=useNodeRef<'Node3D'>();useProcess(ref,{},c=>{checks.nativeRig=c.command('getSceneBoneCount','.')===2;});return <NativeScene ref={ref} scene={scene} position={{x:1.4,y:0,z:0}}/>;}\nfunction Model(){\n const scene=useResource('/assets/rigged.glb','PackedScene'),ref=useNodeRef<'Node3D'>(),started=React.useRef(false);\n useProcess(ref,{writes:['prefabPlayback']},c=>{if(started.current)return;const paths=c.command<string[]>('listSceneNodes'),skeleton=paths.find(path=>path.endsWith('Skeleton3D')),player=paths.find(path=>path.endsWith('AnimationPlayer'));if(!skeleton||!player)throw Error('Imported rig is missing');const names=c.command<string[]>('getSceneAnimations',player),clip=names.find(name=>name.endsWith('Wave'));if(!clip)throw Error('Imported clip is missing');c.command('playSceneAnimation',player,clip,-1,1,false);c.command('advanceSceneAnimation',player,.5);const p=c.command<{x:number}>('getSceneBonePosition',skeleton,0);checks.model=c.command('getSceneBoneCount',skeleton)===1&&Math.abs(p.x-.5)<.01;started.current=true;});\n return <NativeScene ref={ref} scene={scene} position={{x:-.5,y:0,z:0}} engineOwned={['prefabPlayback']}/>;\n}\nexport default function App(){const ref=useNodeRef<'Node3D'>(),demo=useDemo();useProcess(ref,{},()=>demo.stats({kind:'advanced',...checks}));return <Node3D ref={ref}><Camera3D position={{x:0,y:1,z:4}} rotation={{x:-.15,y:0,z:0}} current/><DirectionalLight3D rotation={{x:-.4,y:-.4,z:0}} lightEnergy={1.5}/><Rig/><NativeRig/><Model/><Prefab/><Blend/><State/></Node3D>;}\n",
    "/assets/advanced.resources.json": "{\n  \"version\": 1,\n  \"assets\": {\n    \"rig\": {\n      \"type\": \"SkeletonProfile\",\n      \"bones\": [\n        {\n          \"name\": \"Root\"\n        },\n        {\n          \"name\": \"Tip\",\n          \"parent\": \"Root\",\n          \"rest\": {\n            \"basis\": {\n              \"x\": {\n                \"x\": 1,\n                \"y\": 0,\n                \"z\": 0\n              },\n              \"y\": {\n                \"x\": 0,\n                \"y\": 1,\n                \"z\": 0\n              },\n              \"z\": {\n                \"x\": 0,\n                \"y\": 0,\n                \"z\": 1\n              }\n            },\n            \"origin\": {\n              \"x\": 0,\n              \"y\": 0.6,\n              \"z\": 0\n            }\n          }\n        }\n      ]\n    },\n    \"green\": {\n      \"type\": \"StandardMaterial3D\",\n      \"properties\": {\n        \"albedo_color\": {\n          \"r\": 0.2,\n          \"g\": 0.8,\n          \"b\": 0.4,\n          \"a\": 1\n        },\n        \"roughness\": 0.7\n      }\n    },\n    \"joint\": {\n      \"type\": \"BoxMesh\",\n      \"properties\": {\n        \"size\": {\n          \"x\": 0.2,\n          \"y\": 0.4,\n          \"z\": 0.2\n        },\n        \"material\": \"green\"\n      }\n    },\n    \"clips\": {\n      \"type\": \"AnimationLibrary\",\n      \"animations\": {\n        \"idle\": {\n          \"length\": 1,\n          \"loop\": true,\n          \"tracks\": [\n            {\n              \"path\": \"Mover:position\",\n              \"keys\": [\n                [\n                  0,\n                  {\n                    \"x\": 0,\n                    \"y\": 0\n                  }\n                ],\n                [\n                  1,\n                  {\n                    \"x\": 0,\n                    \"y\": 0\n                  }\n                ]\n              ]\n            }\n          ]\n        