{
  "name": "@godot-js/playground",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/serve.mjs",
    "test": "node --test scripts/*.test.mjs",
    "test:browser": "node scripts/browser-full-engine-test.mjs && node scripts/browser-engine-editor-test.mjs && node scripts/browser-engine-bridge-test.mjs && node scripts/browser-test.mjs",
    "test:browser:full": "node scripts/browser-full-engine-test.mjs",
    "test:browser:editor": "node scripts/browser-engine-editor-test.mjs",
    "test:browser:bridge": "node scripts/browser-engine-bridge-test.mjs",
    "test:browser:legacy": "node scripts/browser-test.mjs",
    "test:browser:projects": "node scripts/browser-project-test.mjs",
    "build:conformance": "node build.mjs",
    "build:frontend": "node scripts/build-shell.mjs",
    "test:browser:resources": "node scripts/browser-resource-test.mjs",
    "test:browser:completion": "node scripts/browser-resource-test.mjs --completion",
    "test:browser:advanced": "node scripts/browser-resource-test.mjs --advanced",
    "test:browser:parity": "node scripts/browser-resource-test.mjs --parity",
    "test:browser:gameplay": "node scripts/browser-resource-test.mjs --gameplay",
    "test:browser:behaviors": "node scripts/browser-resource-test.mjs --behaviors",
    "test:browser:essentials": "node scripts/browser-resource-test.mjs --essentials",
    "test:browser:details": "node scripts/browser-resource-test.mjs --details",
    "test:browser:presentation": "node scripts/browser-resource-test.mjs --presentation",
    "test:browser:interactions": "node scripts/browser-resource-test.mjs --interactions",
    "test:browser:gpu-probe": "node scripts/browser-gpu-probe.mjs",
    "test:browser:precision": "node scripts/browser-resource-test.mjs --precision",
    "test:browser:fidelity": "node scripts/browser-resource-test.mjs --fidelity",
    "test:browser:usability": "node scripts/browser-resource-test.mjs --usability",
    "test:browser:composition": "node scripts/browser-resource-test.mjs --composition",
    "test:browser:workflows": "node scripts/browser-resource-test.mjs --workflows",
    "test:browser:refinements": "node scripts/browser-resource-test.mjs --refinements"
  },
  "dependencies": {
    "@godot-js/react": "workspace:*",
    "react": "19.3.1",
    "@godot-js/react-browser": "workspace:*",
    "@godot-js/react-build": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/react": "19.3.0",
    "esbuild": "0.25.12",
    "monaco-editor": "0.55.1",
    "playwright": "1.57.0",
    "typescript": "6.0.3",
    "clsx": "2.1.1"
  },
  "version": "0.1.0"
}
