  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/react": "19.3.0",
    "esbuild": "0.25.12",
    "monaco-editor": "0.55.1",
    "playwright": "1.57.0",
    "typescript": "6.0.3"
  }
}
