{
  "name": "@godot-js/playground",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:2d": "node scripts/build.mjs --profile engine-2d-v1",
    "build:2d:release": "node scripts/build.mjs --profile engine-2d-v1 --target template_release",
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/serve.mjs",
    "dev:2d": "PLAYGROUND_DIRECTORY=dist-2d-debug node scripts/serve.mjs",
    "dev:2d:release": "PLAYGROUND_DIRECTORY=dist-2d-release node scripts/serve.mjs",
    "test": "node --test scripts/*.test.mjs",
    "test:browser": "node scripts/browser-demo-regressions-test.mjs && node scripts/browser-full-engine-test.mjs && node scripts/browser-engine-editor-test.mjs && node scripts/browser-engine-bridge-test.mjs && node scripts/browser-test.mjs",
    "test:browser:full": "node scripts/browser-full-engine-test.mjs",
    "test:browser:editor": "node scripts/browser-engine-editor-test.mjs",
    "test:browser:bridge": "node scripts/browser-engine-bridge-test.mjs",
    "test:browser:projects": "node scripts/browser-project-test.mjs",
    "build:conformance": "node build.mjs",
    "build:frontend": "node scripts/build-shell.mjs",
    "test:browser:gpu-probe": "node scripts/browser-gpu-probe.mjs",
    "test:browser:react": "node scripts/browser-demo-regressions-test.mjs && node scripts/browser-react-demos-test.mjs",
    "test:browser:resources": "node scripts/browser-react-demos-test.mjs",
    "test:browser:2d:features": "node scripts/browser-2d-features-test.mjs --site dist-2d-debug",
    "test:browser:matrix": "node scripts/worker-acceptance-matrix.mjs",
    "test:browser:release-context": "node scripts/browser-release-context-test.mjs",
    "test:browser:regressions": "node scripts/browser-demo-regressions-test.mjs",
    "test:browser:schema4": "node scripts/browser-schema4-flow-test.mjs",
    "test:browser:resource-converters": "node scripts/browser-resource-converters-test.mjs",
    "build:worker": "node scripts/build.mjs",
    "build:2d:worker": "node scripts/build.mjs --profile engine-2d-v1",
    "build:2d:release:worker": "node scripts/build.mjs --profile engine-2d-v1 --target template_release",
    "dev:worker": "node scripts/serve.mjs",
    "dev:2d:worker": "PLAYGROUND_DIRECTORY=dist-2d-debug node scripts/serve.mjs",
    "dev:2d:release:worker": "PLAYGROUND_DIRECTORY=dist-2d-release node scripts/serve.mjs",
    "test:browser:runtime-host": "node scripts/browser-runtime-host-test.mjs",
    "test:browser:contracts": "node scripts/browser-engine-contracts-test.mjs",
    "test:browser:debug-api": "node scripts/browser-debug-api-test.mjs",
    "test:browser:debug-panel": "node scripts/browser-debug-panel-test.mjs",
    "test:browser:api-console": "node scripts/browser-api-console-test.mjs",
    "test:browser:api-console:shell": "node scripts/browser-api-console-shell-test.mjs",
    "test:browser:game-probe": "node scripts/browser-game-probe-test.mjs",
    "test:browser:input-script": "node scripts/browser-input-script-test.mjs",
    "test:browser:lifecycle-events": "node scripts/browser-lifecycle-events-test.mjs",
    "test:browser:runtime-recovery": "node scripts/browser-runtime-recovery-test.mjs",
    "test:browser:sdk-roundtrip": "node scripts/browser-sdk-roundtrip-test.mjs",
    "test:browser:input-script:g0": "node scripts/browser-game-probe-g0.mjs --input-script",
    "test:browser:runtime-call": "node scripts/browser-runtime-call-test.mjs",
    "test:browser:api-console:real": "node scripts/browser-api-console-real-test.mjs",
    "test:browser:storage": "node scripts/browser-project-blob-storage-test.mjs",
    "test:browser:storage-degradation": "node scripts/browser-storage-degradation-test.mjs",
    "test:browser:compiler-recovery": "node scripts/browser-compiler-recovery-test.mjs",
    "test:browser:storage-read-recovery": "node scripts/browser-storage-read-recovery-test.mjs"
  },
  "dependencies": {
    "@godot-js/react": "workspace:*",
    "react": "19.3.1",
    "@godot-js/react-browser": "workspace:*",
    "@godot-js/react-build": "workspace:*",
    "@godot-js/engine": "workspace:*",
    "@godot-js/project-tools": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/react": "19.3.0",
    "esbuild": "0.25.12",
    "monaco-editor": "0.55.1",
    "playwright": "1.57.0",
    "typescript": "6.0.3",
    "clsx": "2.1.1"
  },
  "version": "0.1.0"
}
